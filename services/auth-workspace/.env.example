# ---- Local development (SPRING_PROFILES_ACTIVE=local) ----
# Use these when running against local Docker infrastructure.
# JWT_PRIVATE_KEY: base64-encoded DER private key (no PEM headers, no newlines).
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 | tr -d '\n'
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/auth_db
SPRING_DATASOURCE_USERNAME=collabspace
SPRING_DATASOURCE_PASSWORD=collabspace_dev
SPRING_DATA_REDIS_URL=redis://localhost:16379
JWT_PRIVATE_KEY=<base64-encoded-der-private-key>
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=collabspace-api
APP_COOKIE_SECURE=false
# INTERNAL_TOKEN: any fixed value you choose. No API Gateway locally, so send this
# same value by hand on every request (register/login included -- they're not exempt).
INTERNAL_TOKEN=local-dev-internal-token

# ---- AWS dev environment (SPRING_PROFILES_ACTIVE not set) ----
# Use these when running against the live AWS dev environment.
# JWT_PRIVATE_KEY_SSM_PATH=/collabspace/dev/auth/jwt-private-key
# JWT_ISSUER_SSM_PATH=/collabspace/dev/jwt/issuer
# JWT_AUDIENCE_SSM_PATH=/collabspace/dev/jwt/audience
# JWT_JWKS_URI_SSM_PATH=/collabspace/dev/jwt/jwks-uri
# INTERNAL_TOKEN_SSM_PATH=/collabspace/dev/api/internal-token
